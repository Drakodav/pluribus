{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "Exported Seed",
    "description": "Exported from existing EmDash database"
  },
  "settings": {
    "tagline": "Built with EmDash",
    "title": "LuxeBear Balloon Bar"
  },
  "blockTypes": [],
  "collections": [
    {
      "slug": "gallerys",
      "label": "Gallerys",
      "labelSingular": "Gallery",
      "supports": ["drafts", "revisions", "preview", "search"],
      "group": "Luxe",
      "fields": [
        {
          "slug": "image",
          "label": "Image",
          "type": "image",
          "required": true,
          "validation": {
            "allowedMimeTypes": [
              "image/png",
              "image/jpeg",
              "image/gif",
              "image/webp",
              "image/avif",
              "image/jxl",
              "video/"
            ]
          },
          "options": {}
        },
        {
          "slug": "caption",
          "label": "Caption",
          "type": "string",
          "searchable": true
        }
      ]
    },
    {
      "slug": "occasions",
      "label": "Occasions",
      "labelSingular": "Occasion",
      "supports": ["drafts", "revisions", "search", "preview"],
      "group": "Luxe",
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        }
      ]
    },
    {
      "slug": "pages",
      "label": "Pages",
      "labelSingular": "Page",
      "supports": ["drafts", "revisions", "preview", "search", "seo"],
      "urlPattern": "/{slug}",
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "content",
          "label": "Content",
          "type": "portableText",
          "searchable": true
        }
      ]
    },
    {
      "slug": "posts",
      "label": "Posts",
      "labelSingular": "Post",
      "supports": ["drafts", "revisions", "preview", "scheduling", "search", "seo"],
      "urlPattern": "/posts/{slug}",
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "featured_image",
          "label": "Featured Image",
          "type": "image"
        },
        {
          "slug": "content",
          "label": "Content",
          "type": "portableText",
          "searchable": true
        },
        {
          "slug": "excerpt",
          "label": "Excerpt",
          "type": "text"
        }
      ]
    }
  ],
  "defaultLocale": "en",
  "taxonomies": [
    {
      "id": "tax:category",
      "name": "category",
      "label": "Categories",
      "labelSingular": "Category",
      "hierarchical": true,
      "collections": ["posts"],
      "terms": [
        {
          "id": "term:category:general",
          "slug": "general",
          "label": "General"
        },
        {
          "id": "term:category:updates",
          "slug": "updates",
          "label": "Updates"
        }
      ]
    },
    {
      "id": "tax:tag",
      "name": "tag",
      "label": "Tags",
      "labelSingular": "Tag",
      "hierarchical": false,
      "collections": ["posts"],
      "terms": [
        {
          "id": "term:tag:starter",
          "slug": "starter",
          "label": "Starter"
        },
        {
          "id": "term:tag:example",
          "slug": "example",
          "label": "Example"
        }
      ]
    }
  ],
  "menus": [
    {
      "id": "menu:primary",
      "name": "primary",
      "label": "Primary Navigation",
      "items": [
        {
          "type": "custom",
          "label": "Home",
          "url": "/"
        },
        {
          "type": "custom",
          "label": "Posts",
          "url": "/posts"
        },
        {
          "type": "custom",
          "label": "About",
          "url": "/about"
        }
      ]
    }
  ],
  "widgetAreas": [
    {
      "name": "sidebar",
      "label": "Sidebar",
      "description": "Sidebar widget area",
      "widgets": [
        {
          "type": "component",
          "title": "Search",
          "componentId": "core:search"
        },
        {
          "type": "component",
          "title": "Categories",
          "componentId": "core:categories"
        },
        {
          "type": "component",
          "title": "Recent Posts",
          "componentId": "core:recent-posts",
          "props": {
            "count": 5
          }
        }
      ]
    }
  ]
}
