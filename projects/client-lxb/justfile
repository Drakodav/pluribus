set dotenv-load

# List available recipes
default:
    @just --list

# Verify system prerequisites
doctor:
    @which node || echo "Node.js not found"
    @which pnpm || echo "pnpm not found"
    @which docker || echo "Docker not found (optional for local Directus)"

# Install project dependencies
setup:
    pnpm install

# Run Astro development server
dev:
    pnpm run dev

# Build the Astro site for production
build:
    pnpm run build

# Preview the production build locally
preview:
    pnpm run preview

# Run Astro type check
check:
    pnpm run check

# Generate types from Directus,
directus-types:
    pnpm dlx directus-ts-typegen --directus-host "${DIRECTUS_URL}" --directus-token "${DIRECTUS_ADMIN_TOKEN}" --type-style type > ./src/types/directus.ts

# Pre-commit checks required by monorepo orchestration
pre-commit:
    @echo "Running client-lxb checks (typecheck & build)..."
    pnpm run check
    pnpm run build

