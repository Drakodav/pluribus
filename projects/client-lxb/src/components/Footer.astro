---
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";

export interface Props {
  siteTitle?: string;
}

const { siteTitle = "Luxe Bear — Balloon Bar" } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="mt-20 border-t border-border/70 bg-gradient-to-b from-background to-secondary/30 pt-16 pb-12 text-foreground">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4">
      <!-- Column 1: Studio Identity & Brand Vision -->
      <div class="flex flex-col gap-4">
        <div class="flex items-center gap-2">
          <img
            src="/branding/logo.svg"
            alt={siteTitle}
            class="h-8 w-auto object-contain"
          />
          <div class="flex flex-col">
            <span class="text-[11px] font-bold tracking-widest uppercase text-primary">
              Luxe Bear Studio
            </span>
            <span class="font-serif text-lg font-bold leading-tight">
              Balloon Bar
            </span>
          </div>
        </div>
        <p class="text-sm text-muted-foreground leading-relaxed">
          The luxury balloon styling division of Luxe Bear Studio. We craft bespoke organic arches, personalized easel backdrops, and signature Pop-Me reveal balloons.
        </p>
        <div class="mt-1">
          <Badge variant="champagne" size="sm">
            ✨ Handcrafted Luxury Decor
          </Badge>
        </div>
      </div>

      <!-- Column 2: Occasions -->
      <div class="flex flex-col gap-3">
        <h4 class="font-serif text-base font-bold text-foreground">
          Browse by Occasion
        </h4>
        <ul class="flex flex-col gap-2 text-sm text-muted-foreground">
          <li>
            <a href="/#occasions" class="transition-colors hover:text-primary">
              Birthdays & Milestones
            </a>
          </li>
          <li>
            <a href="/#occasions" class="transition-colors hover:text-primary">
              Communions & Confirmations
            </a>
          </li>
          <li>
            <a href="/#occasions" class="transition-colors hover:text-primary">
              Gender Reveals ("Pop Me")
            </a>
          </li>
          <li>
            <a href="/#occasions" class="transition-colors hover:text-primary">
              The Bridal Era & Weddings
            </a>
          </li>
          <li>
            <a href="/#occasions" class="transition-colors hover:text-primary">
              Pop-Me Gift Encasements
            </a>
          </li>
          <li>
            <a href="/#occasions" class="transition-colors hover:text-primary">
              Christmas & Festive Celebrations
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Service Scope & Location -->
      <div class="flex flex-col gap-3">
        <h4 class="font-serif text-base font-bold text-foreground">
          Service Locations & Delivery
        </h4>
        <p class="text-sm text-muted-foreground leading-relaxed">
          Proudly serving local towns across County Meath, Dublin, and surrounding areas including Navan, Ashbourne, Swords, and Blanchardstown.
        </p>
        <p class="text-xs text-muted-foreground/80">
          * Deliveries outside our primary service zone are happily accommodated with custom distance travel fees.
        </p>
        <div class="mt-2">
          <a href="/#inquiry">
            <Button variant="balloon-outline" size="sm">
              Check Date Availability
            </Button>
          </a>
        </div>
      </div>

      <!-- Column 4: Balloon Care & Store Line Rule -->
      <div class="flex flex-col gap-3 rounded-2xl border border-border/80 bg-card/60 p-5 shadow-xs backdrop-blur-xs">
        <div class="flex items-center gap-2">
          <span class="text-lg">🎈</span>
          <h4 class="font-serif text-sm font-bold text-foreground">
            The Store Line Policy
          </h4>
        </div>
        <p class="text-xs text-muted-foreground leading-relaxed">
          Balloons are delicate living art. Once our installations are completed or bouquets are handed over, responsibility for temperature regulation, sharp objects, and popping care transfers to the client.
        </p>
        <a href="/#care" class="text-xs font-semibold text-primary transition-colors hover:underline">
          Read Balloon Care Guidelines &rarr;
        </a>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-border/50 pt-8 text-xs text-muted-foreground sm:flex-row">
      <p>© {currentYear} Luxe Bear Studio. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <a href="/#care" class="hover:text-foreground">Balloon Care</a>
        <span>•</span>
        <a href="/#inquiry" class="hover:text-foreground">Inquiries</a>
        <span>•</span>
        <a href="/_emdash/admin" class="hover:text-foreground opacity-60">Admin</a>
      </div>
    </div>
  </div>
</footer>

