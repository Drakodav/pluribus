---
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";
import { Label } from "@/components/ui/label";

export interface Props {
  title?: string;
  subtitle?: string;
  bookingPolicyNotice?: string;
  serviceLocationsNotice?: string;
  occasions?: Array<{ title: string }>;
  offerings?: Array<{ title: string; price?: string }>;
  editTitle?: any;
  editSubtitle?: any;
  editBookingNotice?: any;
  editLocationNotice?: any;
}

const {
  title = "Request a Booking / Quote",
  subtitle = "Fill out your celebration details below and our team will get in touch to confirm date availability and exact pricing.",
  bookingPolicyNotice = "Submitting this inquiry form does not guarantee or confirm your booking. We will review date availability and reach out to confirm details.",
  serviceLocationsNotice = "We serve local towns across County Meath, Dublin, and surrounding areas. Locations outside our standard radius may incur an additional delivery travel fee.",
  occasions = [],
  offerings = [],
  editTitle,
  editSubtitle,
  editBookingNotice,
  editLocationNotice,
} = Astro.props;
---

<section id="inquiry" class="mx-auto max-w-4xl py-12">
  <div class="mb-8 text-center">
    <Badge variant="champagne" size="sm" className="mb-3">
      ✨ Reserve Your Date
    </Badge>
    <h2
      class="font-serif text-3xl font-bold tracking-tight text-foreground sm:text-4xl"
      {...editTitle}
    >
      {title}
    </h2>
    <p
      class="mx-auto mt-2 max-w-2xl text-sm sm:text-base text-muted-foreground leading-relaxed"
      {...editSubtitle}
    >
      {subtitle}
    </p>
  </div>

  <Card className="overflow-hidden border-border bg-card p-6 sm:p-10 shadow-lg">
    <!-- Notice Disclaimers Banner -->
    <div class="mb-8 flex flex-col gap-3 rounded-2xl border border-primary/20 bg-primary/5 p-4 sm:p-5 text-xs sm:text-sm text-foreground/90">
      <div class="flex items-start gap-2.5">
        <span class="text-base leading-none">⚠️</span>
        <div {...editBookingNotice}>
          <strong class="font-semibold text-foreground">Booking Notice:</strong> {bookingPolicyNotice}
        </div>
      </div>
      <div class="flex items-start gap-2.5 border-t border-primary/10 pt-2.5">
        <span class="text-base leading-none">📍</span>
        <div {...editLocationNotice}>
          <strong class="font-semibold text-foreground">Service Scope:</strong> {serviceLocationsNotice}
        </div>
      </div>
    </div>

    <!-- The Form -->
    <form class="flex flex-col gap-6" onsubmit="return false;">
      <!-- Row 1: Name & Phone -->
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div class="flex flex-col gap-2">
          <Label htmlFor="client-name">Your Full Name *</Label>
          <Input
            id="client-name"
            name="name"
            type="text"
            placeholder="e.g. Sarah Jenkins"
            required
          />
        </div>
        <div class="flex flex-col gap-2">
          <Label htmlFor="client-phone">Phone Number *</Label>
          <Input
            id="client-phone"
            name="phone"
            type="tel"
            placeholder="e.g. 087 123 4567"
            required
          />
        </div>
      </div>

      <!-- Row 2: Email & Location -->
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div class="flex flex-col gap-2">
          <Label htmlFor="client-email">Email Address *</Label>
          <Input
            id="client-email"
            name="email"
            type="email"
            placeholder="sarah@example.com"
            required
          />
        </div>
        <div class="flex flex-col gap-2">
          <Label htmlFor="client-location">General Town / Area *</Label>
          <Input
            id="client-location"
            name="location"
            type="text"
            placeholder="e.g. Navan, Ashbourne, Swords, Meath"
            required
          />
          <span class="text-[11px] text-muted-foreground">
            General town is fine for delivery fee calculations.
          </span>
        </div>
      </div>

      <!-- Row 3: Occasion & Event Date -->
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div class="flex flex-col gap-2">
          <Label htmlFor="client-occasion">Celebration Occasion</Label>
          <select
            id="client-occasion"
            name="occasion"
            class="flex h-11 w-full rounded-2xl border border-border bg-card px-4 py-2 text-sm text-foreground shadow-xs transition-colors focus-visible:border-primary focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-primary/20"
          >
            {
              occasions.map((occ) => (
                <option value={occ.title}>{occ.title}</option>
              ))
            }
            <option value="other">Other Celebration / Custom</option>
          </select>
        </div>

        <div class="flex flex-col gap-2">
          <Label htmlFor="client-date">Event Date</Label>
          <Input
            id="client-date"
            name="date"
            type="date"
          />
        </div>
      </div>

      <!-- Row 4: Color Palette & Fulfillment -->
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div class="flex flex-col gap-2">
          <Label htmlFor="client-palette">Preferred Color Palette</Label>
          <Input
            id="client-palette"
            name="palette"
            type="text"
            placeholder="e.g. Sage green & champagne gold, Blush & nude"
          />
        </div>
        <div class="flex flex-col gap-2">
          <Label htmlFor="client-fulfillment">Fulfillment Preference</Label>
          <select
            id="client-fulfillment"
            name="fulfillment"
            class="flex h-11 w-full rounded-2xl border border-border bg-card px-4 py-2 text-sm text-foreground shadow-xs transition-colors focus-visible:border-primary focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-primary/20"
          >
            <option value="delivery">Delivery & On-Site Setup at Venue</option>
            <option value="pickup">Customer Collection / Pickup</option>
          </select>
        </div>
      </div>

      <!-- Offerings / Package Interest Checkboxes -->
      {
        offerings && offerings.length > 0 && (
          <div class="flex flex-col gap-2.5">
            <Label>Package Offerings of Interest (Optional)</Label>
            <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-2">
              {offerings.map((item) => (
                <label class="flex cursor-pointer items-center justify-between rounded-2xl border border-border/80 bg-background/60 p-3.5 transition-all hover:border-primary/40 hover:bg-secondary/40">
                  <span class="flex items-center gap-2.5">
                    <input
                      type="checkbox"
                      name="selected_products"
                      value={item.title}
                      class="h-4 w-4 rounded-md border-border accent-primary"
                    />
                    <span class="text-xs sm:text-sm font-medium text-foreground">
                      {item.title}
                    </span>
                  </span>
                  {item.price && (
                    <span class="text-xs font-semibold text-primary">
                      {item.price}
                    </span>
                  )}
                </label>
              ))}
            </div>
          </div>
        )
      }

      <!-- Custom Notes / Vision Textarea -->
      <div class="flex flex-col gap-2">
        <Label htmlFor="client-details">Event Vision & Custom Notes</Label>
        <Textarea
          id="client-details"
          name="details"
          rows={4}
          placeholder="Tell us about the venue, custom vinyl names (e.g. 'Emma is One'), milestone numbers, or specific theme..."
        />
      </div>

      <!-- Balloon Care & Store Line Rule Agreement Checkbox -->
      <div class="rounded-2xl border border-border/80 bg-secondary/30 p-4">
        <label class="flex cursor-pointer items-start gap-3">
          <input
            type="checkbox"
            name="agree_care"
            required
            class="mt-1 h-4 w-4 rounded-md border-border accent-primary"
          />
          <span class="text-xs text-foreground/90 leading-relaxed">
            I understand and accept <strong>The Store Line Balloon Care Policy</strong>: balloons are sensitive to temperature, sunlight, and sharp hazards. Once delivered, installed, or collected, care responsibility belongs to the client.
          </span>
        </label>
      </div>

      <!-- Submit Action -->
      <Button
        variant="balloon"
        size="lg"
        className="w-full text-base font-semibold"
      >
        Submit Booking Request ✨
      </Button>

      <p class="text-center text-xs text-muted-foreground">
        Prefer to speak directly? Feel free to call or message Luxe Bear Studio anytime.
      </p>
    </form>
  </Card>
</section>

