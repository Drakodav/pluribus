---
import { dClient } from "@/lib/directus";

const siteSettings = await dClient.getSiteSettings();
const occasions = await dClient.getOccasions();
---

<footer class="footer">
  <div class="container footer-container">
    <div class="footer-grid">
      <div class="footer-col brand-col">
        <h3 class="footer-logo">LUXE BEAR</h3>
        <p class="brand-tagline">
          Elevating every milestone with bespoke organic balloon installations,
          custom acrylic backdrops, and specialty reveal moments.
        </p>
        <p class="umbrella-tag">
          A division of <strong>{siteSettings?.site_brand_name}</strong>
        </p>
      </div>

      <div class="footer-col">
        <h4 class="footer-heading">Occasions</h4>
        <ul class="footer-links">
          {
            occasions.map((occasion) => (
              <li>
                <a href={`/occasions/${occasion.slug}`}>{occasion.title}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="footer-heading">Quick Links</h4>
        <ul class="footer-links">
          <li><a href="/gallery">Gallery Portfolio</a></li>
          <li><a href="/pricing">Pricing & Packages</a></li>
          <li><a href="/book">Inquiry & Booking Form</a></li>
          <li><a href="/balloon-care">Balloon Care & Terms</a></li>
          <li><a href="/contact">Direct Contact</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="footer-heading">Service Coverage</h4>
        <p class="footer-info">
          Serving: {siteSettings?.service_area}
        </p>
        <p class="footer-info" style="margin-top: 0.5rem;">
          Email: <a href={`mailto:${siteSettings?.site_contact_email}`}
            >{siteSettings?.site_contact_email}</a
          >
        </p>
        <p class="footer-info">
          Phone: <a href={`tel:${siteSettings?.site_contact_phone}`}
            >{siteSettings?.site_contact_phone}</a
          >
        </p>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        &copy; {new Date().getFullYear()}
        {siteSettings?.site_brand_name} - {siteSettings?.division_name}. All
        rights reserved.
      </p>
      <div class="legal-links">
        <a href="/balloon-care">The Store Line Rule (Balloon Care)</a>
        <span>&bull;</span>
        <a href="/book">Inquire Online</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: #211d1d;
    color: #ebd8d0;
    padding-top: 4rem;
    padding-bottom: 2.5rem;
    margin-top: 5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.25fr;
    gap: 3rem;
  }

  .footer-logo {
    color: #ffffff;
    font-size: 1.5rem;
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
  }

  .brand-tagline {
    font-size: 0.9rem;
    color: #c0b0a8;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .umbrella-tag {
    font-size: 0.8rem;
    color: var(--accent-gold);
  }

  .footer-heading {
    color: #ffffff;
    font-size: 0.95rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-links a {
    color: #c0b0a8;
    font-size: 0.9rem;
  }

  .footer-links a:hover {
    color: var(--accent-gold);
  }

  .footer-info {
    font-size: 0.9rem;
    color: #c0b0a8;
    line-height: 1.5;
  }

  .footer-info a {
    color: var(--accent-gold);
  }

  .footer-bottom {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    color: #9e8f88;
  }

  .legal-links {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .legal-links a {
    color: #c0b0a8;
  }

  .legal-links a:hover {
    color: #ffffff;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>
