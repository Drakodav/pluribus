---
import { Image } from "emdash/ui";
import {
  Card,
  CardHeader,
  CardTitle,
  CardDescription,
  CardContent,
  CardFooter,
} from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";

export interface Props {
  title: string;
  price?: string;
  description?: string;
  isCustomizable?: boolean;
  supportsGiftInsert?: boolean;
  image?: any;
  edit?: any;
  className?: string;
}

const {
  title,
  price,
  description,
  isCustomizable,
  supportsGiftInsert,
  image,
  edit,
  className = "",
} = Astro.props;
---

<Card
  balloon
  className={`group flex flex-col justify-between overflow-hidden border-border/80 bg-card p-2 sm:p-3 transition-all duration-300 hover:border-primary/40 ${className}`}
  {...edit}
>
  <div>
    <!-- Optional Image -->
    {
      image && (
        <div class="balloon-gloss relative mb-3 aspect-16/10 w-full overflow-hidden rounded-2xl bg-secondary/40">
          <Image
            image={image}
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        </div>
      )
    }

    <!-- Header with Title & Price Badge -->
    <CardHeader className="p-4 pb-2">
      <div class="flex items-start justify-between gap-3">
        <CardTitle className="font-serif text-lg font-bold text-foreground">
          {title}
        </CardTitle>
        {
          price && (
            <Badge variant="champagne" size="sm" className="shrink-0 font-bold">
              {price}
            </Badge>
          )
        }
      </div>
      {
        description && (
          <CardDescription className="mt-2 text-xs sm:text-sm leading-relaxed text-muted-foreground">
            {description}
          </CardDescription>
        )
      }
    </CardHeader>
  </div>

  <!-- Badges & Action -->
  <CardFooter className="flex flex-col items-start gap-3 p-4 pt-2">
    <div class="flex flex-wrap gap-1.5">
      {
        isCustomizable && (
          <Badge variant="secondary" size="sm">
            ✨ Custom Vinyl Name
          </Badge>
        )
      }
      {
        supportsGiftInsert && (
          <Badge variant="blush" size="sm">
            🎁 Pop-Me Gift Insert
          </Badge>
        )
      }
    </div>

    <a
      href="#inquiry"
      class="inline-flex text-xs font-semibold text-primary transition-colors hover:underline"
    >
      Inquire about this style &rarr;
    </a>
  </CardFooter>
</Card>

