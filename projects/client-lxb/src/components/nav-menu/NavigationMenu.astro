---
import LiveSearch from "emdash/ui/search";
import type { MediaReference } from "@/utils/site-identity";

export interface MenuItem {
  url: string;
  label: string;
  target?: string | null;
}

export interface Props {
  siteTitle?: string;
  siteLogo?: MediaReference | null;
  menu?: {
    items: MenuItem[];
  } | null;
}

const { siteTitle = "My Site", siteLogo, menu } = Astro.props;
---

<header class="header">
  <nav class="nav-container">
    <div class="brand">
      <a href="/" class="brand-link">
        {
          siteLogo ? (
            <img
              src={siteLogo.url}
              alt={siteLogo.alt || siteTitle}
              class="brand-logo"
            />
          ) : (
            <span class="brand-title">{siteTitle}</span>
          )
        }
      </a>
    </div>

    <div class="nav-menu-group">
      {
        menu?.items && menu.items.length > 0 && (
          <ul class="nav-links">
            {menu.items.map((item) => (
              <li>
                <a
                  href={item.url}
                  target={item.target ?? undefined}
                  rel={
                    item.target === "_blank" ? "noopener noreferrer" : undefined
                  }
                  class="nav-link"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <div class="search-wrapper">
        <LiveSearch placeholder="Search..." collections={["posts", "pages"]} />
      </div>
    </div>
  </nav>
</header>

<style>
  .header {
    border-bottom: 1px solid #e5e7eb;
    background-color: #ffffff;
    width: 100%;
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .brand-link {
    text-decoration: none;
    color: #111827;
    display: flex;
    align-items: center;
  }

  .brand-logo {
    height: 40px;
    width: auto;
    display: block;
    object-fit: contain;
  }

  .brand-title {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .nav-menu-group {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    text-decoration: none;
    color: #4b5563;
    font-size: 0.95rem;
    font-weight: 500;
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .nav-link:hover {
    color: #111827;
    background-color: #f3f4f6;
  }

  .search-wrapper {
    display: flex;
    align-items: center;
  }

  @media (max-width: 768px) {
    .nav-container {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
      padding: 0.75rem 1rem;
    }

    .nav-menu-group {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }

    .nav-links {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem 1rem;
    }

    .search-wrapper {
      width: 100%;
    }
  }
</style>

