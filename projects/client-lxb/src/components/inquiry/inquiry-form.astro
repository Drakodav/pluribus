---
import { dClient } from "@/lib/directus";
import { InquiryForm as InquiryFormReact } from "./inquiry-form";

interface Props {
  preselectedOccasion?: string | null;
}

const { preselectedOccasion = "" } = Astro.props;
const directusUrl =
  import.meta.env.DIRECTUS_URL || "https://admin-lxb.apps.vlmd.cc";
const occasions = await dClient.getOccasions();
---

<InquiryFormReact
  client:load
  directusUrl={directusUrl}
  occasions={occasions}
  preselectedOccasion={preselectedOccasion}
/>
