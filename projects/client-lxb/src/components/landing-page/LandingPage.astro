---
// Landing Page for Luxe Bear - Balloon Bar
// Powered by dynamic EmDash CMS collections & modular ShadCN components
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import OccasionCard from "@/components/OccasionCard.astro";
import ProductCard from "@/components/ProductCard.astro";
import CareNotice from "@/components/CareNotice.astro";
import InquiryForm from "@/components/InquiryForm.astro";

interface Props {
  homePage?: any;
  occasions?: any[];
  products?: any[];
  activeCampaign?: any;
}

const {
  homePage = null,
  occasions: dbOccasions = [],
  products: dbProducts = [],
  activeCampaign = null,
} = Astro.props;

// 1. Hero & Seasonal Spotlight
const seasonalBadge =
  activeCampaign?.data?.badge_text ||
  "Now Booking for Upcoming Celebrations";

const heroHeadline =
  activeCampaign?.data?.headline ||
  homePage?.data?.hero_headline ||
  "Luxe Bear — Balloon Bar";

const heroTagline =
  homePage?.data?.hero_tagline || "By Luxe Bear Studio";

const heroDescription =
  activeCampaign?.data?.description ||
  homePage?.data?.hero_description ||
  "From organic arches and custom vinyl backdrops to our signature Pop-Me balloons — Luxe Bear Balloon Bar brings magic to your celebrations.";

// 2. Section Headers & Text
const occasionsTitle =
  homePage?.data?.occasions_title || "Explore by Occasion";

const occasionsSubtitle =
  homePage?.data?.occasions_subtitle ||
  "We organize our designs by celebration so you find the exact style for your event without getting lost in technical balloon terminology.";

const offeringsTitle =
  homePage?.data?.offerings_title || "Our Signature Offerings & Pricing Guide";

const offeringsSubtitle =
  homePage?.data?.offerings_subtitle ||
  "Hand-crafted luxury balloon installations and bespoke event decor tailored to your palette.";

const inquiryTitle =
  homePage?.data?.inquiry_title || "Request a Booking / Quote";

const inquirySubtitle =
  homePage?.data?.inquiry_subtitle ||
  "Fill out your celebration details below and our team will get in touch to confirm availability and exact pricing.";

const bookingPolicyNotice =
  homePage?.data?.booking_policy_notice ||
  "Submitting this inquiry form does not guarantee or confirm your booking. We will review date availability and reach out to confirm details.";

const serviceLocationsNotice =
  homePage?.data?.service_locations_notice ||
  "We serve local towns across County Meath, Dublin, and surrounding areas. Locations outside our standard radius may incur an additional delivery travel fee.";

const careTitle =
  homePage?.data?.care_title || "🎈 Balloon Care & The Store Line Rule";

const careDescription =
  homePage?.data?.care_description ||
  "Balloons are delicate and sensitive to heat, sunlight, sharp objects, and transit. Once delivered or collected, balloon care becomes your responsibility.";

// 3. Browse by Occasion (with graceful fallback)
const fallbackOccasions = [
  {
    title: "Christmas & Seasonal",
    subtitle: "Festive balloon arches, organic garland & holiday party setups",
    tag: "Current Season",
    href: "#inquiry",
    image: null,
  },
  {
    title: "Birthdays",
    subtitle: "Milestone numbers, themed organic arches & easel displays",
    tag: undefined,
    href: "#inquiry",
    image: null,
  },
  {
    title: "Communions & Confirmations",
    subtitle: "Elegant neutral backdrops, easel signs & organic garland",
    tag: "Booking Early 2027",
    href: "#inquiry",
    image: null,
  },
  {
    title: "Gender Reveals",
    subtitle: "Signature double-layer 'Pop Me' reveal balloons with pink/blue confetti",
    tag: undefined,
    href: "#inquiry",
    image: null,
  },
  {
    title: "The Bridal Era",
    subtitle: "Hen parties, engagement backdrops, proposal setups & weddings",
    tag: undefined,
    href: "#inquiry",
    image: null,
  },
  {
    title: "Pop-Me Gifts",
    subtitle: "Custom bubble balloon gifting (customer-provided gift inserted)",
    tag: undefined,
    href: "#inquiry",
    image: null,
  },
];

const occasions =
  dbOccasions.length > 0
    ? dbOccasions.map((occ: any) => ({
        title: occ.data.title,
        subtitle: occ.data.subtitle || "",
        tag: occ.data.hero_badge || undefined,
        href: `/occasions/${occ.slug}`,
        image: occ.data.hero_image,
        edit: occ.edit,
      }))
    : fallbackOccasions;

// 4. Products & Offerings (with graceful fallback)
const fallbackOfferings = [
  {
    title: "The Signature Bear Balloon Bouquet",
    price: "From €85",
    description:
      "Our iconic centerpiece with a bespoke crystal bubble balloon, miniature teddy charm, and custom metallic lettering.",
    isCustomizable: true,
    supportsGiftInsert: true,
  },
  {
    title: "Organic Balloon Garland",
    price: "From €35 / metre",
    description:
      "Flowing organic styling, available on its own or paired with fully customizable vinyl backdrops with names or personalized messages.",
    isCustomizable: true,
    supportsGiftInsert: false,
  },
  {
    title: "Welcome Signs & Easel Package",
    price: "From €140",
    description:
      "Welcome signs displayed on wooden or metal easels, accented with organic balloon clusters or full climbing arches.",
    isCustomizable: true,
    supportsGiftInsert: false,
  },
  {
    title: "Signature 'Pop Me' Reveal Balloons",
    price: "From €65",
    description:
      "Special double-balloon design: inner latex balloon pops to reveal confetti or gifts, while the outer bubble stays intact.",
    isCustomizable: true,
    supportsGiftInsert: true,
  },
];

const offerings =
  dbProducts.length > 0
    ? dbProducts.map((prod: any) => {
        let desc = "";
        if (typeof prod.data.description === "string") {
          desc = prod.data.description;
        } else if (Array.isArray(prod.data.description)) {
          desc = prod.data.description
            .map((b: any) =>
              b.children?.map((c: any) => c.text).join(" ") || ""
            )
            .join(" ");
        } else if (prod.data.included_features) {
          desc = prod.data.included_features;
        }
        return {
          title: prod.data.title,
          price: prod.data.starting_price || "",
          description: desc,
          isCustomizable: prod.data.is_customizable,
          supportsGiftInsert: prod.data.supports_gift_insert,
          image: prod.data.featured_image,
          edit: prod.edit,
        };
      })
    : fallbackOfferings;
---

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <!-- 1. Hero & Seasonal Spotlight -->
  <section class="relative my-8 overflow-hidden rounded-3xl border border-border/80 bg-gradient-to-b from-card via-card to-secondary/30 p-8 sm:p-14 lg:p-20 shadow-sm text-center">
    <!-- Subtle Balloon Ambient Glow -->
    <div class="pointer-events-none absolute -top-24 -left-24 h-72 w-72 rounded-full bg-primary/10 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-24 -right-24 h-72 w-72 rounded-full bg-secondary/80 blur-3xl" aria-hidden="true"></div>

    <div class="relative mx-auto flex max-w-3xl flex-col items-center gap-5">
      <!-- Spotlight Seasonal Badge -->
      <Badge variant="seasonal" size="lg" className="gap-2 px-4 py-1.5 shadow-xs">
        <span class="inline-block h-2 w-2 rounded-full bg-primary animate-pulse" aria-hidden="true"></span>
        <span>{seasonalBadge}</span>
      </Badge>

      <!-- Main Headline & Subtitles -->
      <h1
        class="font-serif text-4xl font-extrabold tracking-tight text-foreground sm:text-6xl lg:text-7xl leading-[1.08]"
        {...homePage?.edit?.hero_headline}
      >
        {heroHeadline}
      </h1>

      <p
        class="font-serif text-base font-semibold tracking-wider uppercase text-primary sm:text-lg"
        {...homePage?.edit?.hero_tagline}
      >
        {heroTagline}
      </p>

      <p
        class="max-w-2xl text-base text-muted-foreground sm:text-lg leading-relaxed"
        {...homePage?.edit?.hero_description}
      >
        {heroDescription}
      </p>

      <!-- CTA Action Pill Buttons -->
      <div class="mt-4 flex flex-wrap items-center justify-center gap-3.5">
        <a href="#inquiry">
          <Button variant="balloon" size="lg" className="text-base font-semibold">
            Request a Booking ✨
          </Button>
        </a>
        <a href="#occasions">
          <Button variant="balloon-outline" size="lg" className="text-base">
            Browse by Occasion &darr;
          </Button>
        </a>
      </div>

      <!-- Quick Feature Pill Highlights -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-2 pt-2 text-xs text-muted-foreground">
        <span class="rounded-full border border-border/70 bg-background/80 px-3 py-1 shadow-2xs">
          🎈 Organic Garland & Arches
        </span>
        <span class="rounded-full border border-border/70 bg-background/80 px-3 py-1 shadow-2xs">
          ✨ Custom Vinyl Named Backdrops
        </span>
        <span class="rounded-full border border-border/70 bg-background/80 px-3 py-1 shadow-2xs">
          🎁 Double-Layer "Pop-Me" Balloons
        </span>
        <span class="rounded-full border border-border/70 bg-background/80 px-3 py-1 shadow-2xs">
          📍 Meath & Dublin Setup
        </span>
      </div>
    </div>
  </section>

  <!-- 2. Browse by Occasion Section -->
  <section id="occasions" class="my-20 scroll-mt-24">
    <div class="mb-12 text-center">
      <Badge variant="champagne" size="sm" className="mb-3">
        Celebration First
      </Badge>
      <h2
        class="font-serif text-3xl font-bold tracking-tight text-foreground sm:text-4xl"
        {...homePage?.edit?.occasions_title}
      >
        {occasionsTitle}
      </h2>
      <p
        class="mx-auto mt-2 max-w-2xl text-sm sm:text-base text-muted-foreground leading-relaxed"
        {...homePage?.edit?.occasions_subtitle}
      >
        {occasionsSubtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        occasions.map((occasion: any) => (
          <OccasionCard
            title={occasion.title}
            subtitle={occasion.subtitle}
            tag={occasion.tag}
            href={occasion.href}
            image={occasion.image}
            edit={occasion.edit}
          />
        ))
      }
    </div>
  </section>

  <!-- 3. Signature Offerings Overview -->
  <section id="offerings" class="my-20 scroll-mt-24">
    <div class="mb-12 text-center">
      <Badge variant="champagne" size="sm" className="mb-3">
        Handcrafted Packages
      </Badge>
      <h2
        class="font-serif text-3xl font-bold tracking-tight text-foreground sm:text-4xl"
        {...homePage?.edit?.offerings_title}
      >
        {offeringsTitle}
      </h2>
      <p
        class="mx-auto mt-2 max-w-2xl text-sm sm:text-base text-muted-foreground leading-relaxed"
        {...homePage?.edit?.offerings_subtitle}
      >
        {offeringsSubtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        offerings.map((item: any) => (
          <ProductCard
            title={item.title}
            price={item.price}
            description={item.description}
            isCustomizable={item.isCustomizable}
            supportsGiftInsert={item.supportsGiftInsert}
            image={item.image}
            edit={item.edit}
          />
        ))
      }
    </div>
  </section>

  <!-- 4. Balloon Care & Store Line Rule Notice -->
  <CareNotice
    title={careTitle}
    description={careDescription}
    editTitle={homePage?.edit?.care_title}
    editDescription={homePage?.edit?.care_description}
  />

  <!-- 5. Booking Request / Inquiry Form -->
  <InquiryForm
    title={inquiryTitle}
    subtitle={inquirySubtitle}
    bookingPolicyNotice={bookingPolicyNotice}
    serviceLocationsNotice={serviceLocationsNotice}
    occasions={occasions}
    offerings={offerings}
    editTitle={homePage?.edit?.inquiry_title}
    editSubtitle={homePage?.edit?.inquiry_subtitle}
    editBookingNotice={homePage?.edit?.booking_policy_notice}
    editLocationNotice={homePage?.edit?.service_locations_notice}
  />
</div>
