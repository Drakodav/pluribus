---
import {
  getEmDashEntry,
  getEmDashReferences,
  getSeoMeta,
  decodeSlug,
  getSiteSettings,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from "@/components/ui/card";
import ProductCard from "@/components/ProductCard.astro";
import CareNotice from "@/components/CareNotice.astro";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
  return Astro.rewrite("/404");
}

const { entry: occasion, cacheHint } = await getEmDashEntry("occasions", slug);

if (!occasion) {
  return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(occasion, {
  siteTitle,
  siteUrl: Astro.url.origin,
  path: Astro.url.pathname.replace(/\/$/, ""),
});

// Fetch formal relational links
const { entries: featuredProducts } = await getEmDashReferences(
  "occasions",
  occasion.data.id,
  "featured_products"
);

const { entries: galleryItems } = await getEmDashReferences(
  "occasions",
  occasion.data.id,
  "gallery_items"
);
---

<Base
  title={`${occasion.data.title} | ${siteTitle}`}
  description={occasion.data.subtitle || `Bespoke balloon installations for ${occasion.data.title}`}
  content={{ collection: "occasions", id: occasion.data.id, slug }}
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <!-- Breadcrumb -->
    <nav class="mb-8 flex items-center gap-2 text-xs text-muted-foreground sm:text-sm">
      <a href="/" class="hover:text-primary transition-colors">Home</a>
      <span>&rarr;</span>
      <a href="/#occasions" class="hover:text-primary transition-colors">Occasions</a>
      <span>&rarr;</span>
      <span class="font-semibold text-foreground">{occasion.data.title}</span>
    </nav>

    <!-- Occasion Hero -->
    <header class="mb-14 text-center">
      {
        occasion.data.hero_badge && (
          <Badge variant="seasonal" size="lg" className="mb-4">
            {occasion.data.hero_badge}
          </Badge>
        )
      }
      <h1
        class="font-serif text-4xl font-extrabold tracking-tight text-foreground sm:text-5xl lg:text-6xl"
        {...occasion.edit.title}
      >
        {occasion.data.title}
      </h1>
      {
        occasion.data.subtitle && (
          <p
            class="mx-auto mt-3 max-w-2xl text-base text-muted-foreground sm:text-lg leading-relaxed"
            {...occasion.edit.subtitle}
          >
            {occasion.data.subtitle}
          </p>
        )
      }

      {
        occasion.data.hero_image && (
          <div
            class="balloon-gloss mx-auto mt-8 max-h-[440px] max-w-4xl overflow-hidden rounded-3xl border border-border shadow-md"
            {...occasion.edit.hero_image}
          >
            <Image
              image={occasion.data.hero_image}
              class="h-full w-full object-cover max-h-[440px]"
            />
          </div>
        )
      }
    </header>

    <!-- Editorial Intro & Details -->
    {
      occasion.data.intro_text && (
        <section class="mx-auto mb-16 max-w-4xl" {...occasion.edit.intro_text}>
          <Card className="border-border/80 bg-card p-6 sm:p-10 shadow-sm">
            <div class="prose prose-neutral max-w-none text-foreground/90 leading-relaxed sm:text-lg">
              <PortableText value={occasion.data.intro_text} />
            </div>
          </Card>
        </section>
      )
    }

    <!-- Relational Section 1: Featured Products & Packages -->
    {
      featuredProducts && featuredProducts.length > 0 && (
        <section class="my-16 scroll-mt-24">
          <div class="mb-8 text-center sm:text-left">
            <Badge variant="champagne" size="sm" className="mb-2">
              Recommended Packages
            </Badge>
            <h2 class="font-serif text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
              Packages for {occasion.data.title}
            </h2>
            <p class="text-sm text-muted-foreground">
              Curated luxury styles frequently selected for this celebration.
            </p>
          </div>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {featuredProducts.map((prod: any) => (
              <ProductCard
                title={prod.data.title}
                price={prod.data.starting_price}
                description={
                  prod.data.included_features ||
                  (typeof prod.data.description === "string" ? prod.data.description : "")
                }
                isCustomizable={prod.data.is_customizable}
                supportsGiftInsert={prod.data.supports_gift_insert}
                image={prod.data.featured_image}
                edit={prod.edit}
              />
            ))}
          </div>
        </section>
      )
    }

    <!-- Relational Section 2: Real Event Lookbook Gallery -->
    {
      galleryItems && galleryItems.length > 0 && (
        <section class="my-16 scroll-mt-24">
          <div class="mb-8 text-center sm:text-left">
            <Badge variant="champagne" size="sm" className="mb-2">
              Lookbook
            </Badge>
            <h2 class="font-serif text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
              Real Event Gallery
            </h2>
            <p class="text-sm text-muted-foreground">
              Recent setups and bespoke installations created for {occasion.data.title}.
            </p>
          </div>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {galleryItems.map((item: any) => (
              <Card balloon className="overflow-hidden border-border/80 bg-card p-3 shadow-xs">
                {item.data.image && (
                  <div class="balloon-gloss aspect-4/3 w-full overflow-hidden rounded-2xl bg-secondary/30">
                    <Image
                      image={item.data.image}
                      class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
                    />
                  </div>
                )}
                <div class="p-3">
                  {item.data.caption && (
                    <p class="text-sm font-medium text-foreground">
                      {item.data.caption}
                    </p>
                  )}
                  {item.data.color_palette && (
                    <div class="mt-2">
                      <Badge variant="secondary" size="sm">
                        🎨 {item.data.color_palette}
                      </Badge>
                    </div>
                  )}
                </div>
              </Card>
            ))}
          </div>
        </section>
      )
    }

    <!-- Care Disclaimer Notice -->
    <CareNotice />

    <!-- Occasion Booking CTA -->
    <section class="my-16 text-center">
      <Card className="mx-auto max-w-2xl border-primary/20 bg-gradient-to-b from-card to-secondary/30 p-8 sm:p-12 shadow-md">
        <span class="text-4xl">✨</span>
        <h2 class="mt-3 font-serif text-2xl font-bold text-foreground sm:text-3xl">
          Planning a {occasion.data.title}?
        </h2>
        <p class="mx-auto mt-2 max-w-md text-sm text-muted-foreground">
          Reach out early with your celebration date and venue location to reserve our styling team.
        </p>
        <div class="mt-6 flex justify-center">
          <a href="/#inquiry">
            <Button variant="balloon" size="lg" className="text-base font-semibold">
              Inquire for {occasion.data.title} &rarr;
            </Button>
          </a>
        </div>
      </Card>
    </section>
  </div>
</Base>
