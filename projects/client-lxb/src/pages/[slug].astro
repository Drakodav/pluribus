---
import {
  getEmDashEntry,
  getSeoMeta,
  decodeSlug,
  getSiteSettings,
} from "emdash";
import { PortableText } from "emdash/ui";
import Base from "@/layouts/Base.astro";
import { resolveStarterSiteIdentity } from "@/utils/site-identity";
import { Card } from "@/components/ui/card";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
  return Astro.rewrite("/404");
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);

if (!page) {
  return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(page, {
  siteTitle,
  siteUrl: Astro.url.origin,
  path: Astro.url.pathname.replace(/\/$/, ""),
});
---

<Base
  title={seo.title}
  pageTitle={seo.ogTitle}
  description={seo.description}
  canonical={seo.canonical}
  content={{ collection: "pages", id: page.data.id, slug }}
>
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <Card className="border-border/80 bg-card p-6 sm:p-12 shadow-sm">
      <h1
        class="mb-6 font-serif text-3xl font-bold tracking-tight text-foreground sm:text-4xl"
        {...page.edit.title}
      >
        {page.data.title}
      </h1>

      <div class="prose prose-neutral max-w-none text-foreground/90 leading-relaxed sm:text-lg">
        <PortableText value={page.data.content} />
      </div>
    </Card>
  </div>
</Base>
