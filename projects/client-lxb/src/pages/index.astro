---
import { getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { LandingPage } from "@/components/landing-page";

// Fetch dynamic occasions sorted by display order
const { entries: occasions, cacheHint: occasionsCacheHint } =
  await getEmDashCollection("occasions", {
    orderBy: { sort_order: "asc" },
  });

// Fetch catalog products
const { entries: products, cacheHint: productsCacheHint } =
  await getEmDashCollection("products", {
    orderBy: { sort_order: "asc" },
  });

// Fetch seasonal campaigns to determine active spotlight
const { entries: campaigns, cacheHint: campaignsCacheHint } =
  await getEmDashCollection("campaigns");

const activeCampaign =
  campaigns.find((c: any) => c.data?.is_active) || campaigns[0] || null;

const { siteTitle, siteTagline } = resolveStarterSiteIdentity(
  await getSiteSettings(),
);

if (Astro.cache?.enabled) {
  if (occasionsCacheHint) Astro.cache.set(occasionsCacheHint);
  if (productsCacheHint) Astro.cache.set(productsCacheHint);
  if (campaignsCacheHint) Astro.cache.set(campaignsCacheHint);
}
---

<Base title={siteTitle} description={siteTagline}>
  <LandingPage
    occasions={occasions}
    products={products}
    activeCampaign={activeCampaign}
  />
</Base>
