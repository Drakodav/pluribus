---
import Navbar from "../components/common/navbar.astro";
import Footer from "../components/common/footer.astro";
import "../styles/global.css";
import { SITE_METADATA } from "../lib/constants";

interface Props {
  title?: string;
  description?: string | null;
}

const { title = SITE_METADATA.title, description = SITE_METADATA.description } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts for luxury serif & sans typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <script
      type="text/partytown"
      defer
      src="https://analytics.apps.vlmd.cc/script.js"
      data-website-id="49f7959d-a327-4a37-ac23-6aa34fb2d06c"></script>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
