# List available commands
default:
    @just --list

# Verify uv is installed
doctor:
    @which uv || echo "uv is not installed"

# Setup local environment and sync dependencies
setup:
    uv sync

# Run the git history cv extractor script
run:
    uv run main.py

# Format code with ruff
format:
    uv run ruff format .

# Lint code with ruff
lint:
    uv run ruff check .

# Run static type checking with ty
typecheck:
    uv run ty check .

# Run unit tests
test:
    uv run pytest

# Run subproject pre-commit checks
pre-commit:
    @echo "Running git-history-cv-extractor checks (Ruff, pytest, ty)..."
    uv run ruff check --fix .
    uv run ruff format .
    uv run pytest
    uv run ty check .

# Clean temporary files, virtualenv, and output folder
clean:
    rm -rf .venv/ output/

