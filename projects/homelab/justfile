# ==============================================================================
# Pluribus Homelab: Type-Safe Declarative Task Runner Interface
# ==============================================================================

# List available commands
default:
    @just --list

# Run the Homelab CLI directly with arbitrary arguments
cli *args="":
    uv run homelab {{args}}

# Alias for cli
homelab *args="":
    uv run homelab {{args}}

# Verify system prerequisites (uv, docker, terraform)
doctor:
    @echo "=== Checking Homelab System Prerequisites ==="
    @which uv > /dev/null && echo "  [ok] uv found: $(which uv)" || echo "  [error] uv not found (install via brew/curl)"
    @which docker > /dev/null && echo "  [ok] docker found: $(which docker)" || echo "  [warn] docker not found in PATH"
    @which terraform > /dev/null && echo "  [ok] terraform found: $(which terraform)" || echo "  [warn] terraform not found in PATH"
    @echo "Environment check complete."

# Format codebase with ruff and terraform
format:
    uv run ruff format .
    @if which terraform > /dev/null 2>&1 && [ -d "nodes/aperio/terraform" ]; then terraform fmt -recursive nodes/aperio/terraform/; fi

# Lint Python codebase with ruff and check terraform formatting
lint:
    uv run ruff check .
    @if which terraform > /dev/null 2>&1 && [ -d "nodes/aperio/terraform" ]; then terraform fmt -check -recursive nodes/aperio/terraform/; fi

# Run static type checking with ty
typecheck:
    uv run ty check .

# Run test suite
test:
    uv run pytest

# Validate topology.yaml and all Docker Compose service stacks
validate:
    uv run homelab validate

# List all declared services and exposure routing policies
services:
    uv run homelab services

# Generate self-contained WireGuard onboarding bootstrap snippet for any node
node-bootstrap node="macerator":
    uv run homelab node generate-wireguard-bootstrap {{node}}

# Print generated /etc/wireguard/wg0.conf for any node or gateway
mesh-config target="aperio":
    uv run homelab mesh config {{target}}

# SSH into node or gateway (auto-resolving bastion ProxyJump)
ssh-into node="macerator":
    uv run homelab node ssh {{node}}

# SSH shortcut for Aperio Gateway
ssh-aperio:
    uv run homelab node ssh aperio

# SSH shortcut for Macerator Powerhouse
ssh-macerator:
    uv run homelab node ssh macerator

# Sync repository code to a node via rsync over ProxyJump SSH
node-sync node="macerator":
    uv run homelab node sync {{node}}

# Synchronize declared services into Consul Service Catalog
consul-sync node="macerator":
    uv run homelab consul sync {{node}}

# Deploy Gateway IaC and platform VM stack
gateway-deploy user="ubuntu" host="" key="":
    #!/usr/bin/env sh
    set -eu
    echo "Deploying to Aperio Gateway..."
    bash nodes/aperio/vm/deploy.sh "{{user}}" "{{host}}" "{{key}}"

# Check live WireGuard status and peer handshakes on Aperio Gateway
gateway-wireguard-status:
    #!/usr/bin/env sh
    set -eu
    if [ -f .env ]; then set -a; . ./.env; set +a; fi
    IP="${APERIO_PUBLIC_IP:-${GATEWAY_PUBLIC_IP:-}}"
    KEY="${GATEWAY_SSH_KEY:-$HOME/.ssh/id_rsa}"
    if [ -z "$IP" ]; then
        echo "Error: APERIO_PUBLIC_IP / GATEWAY_PUBLIC_IP not defined in .env"
        exit 1
    fi
    echo "=== Aperio WireGuard Status ($IP) ==="
    ssh -o StrictHostKeyChecking=no -i "$KEY" "ubuntu@$IP" "sudo wg show"

# Standard pre-commit hook aggregator
pre-commit: lint format typecheck test validate
