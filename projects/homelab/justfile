# List available homelab commands
default:
    @just --list

# Verify system prerequisites (docker, terraform, shellcheck, shfmt)
doctor:
    @echo "=== Checking Homelab System Prerequisites ==="
    @which docker > /dev/null && echo "  [ok] docker found: $(which docker)" || echo "  [warn] docker not found in PATH"
    @which terraform > /dev/null && echo "  [ok] terraform found: $(which terraform)" || echo "  [warn] terraform not found in PATH"
    @which shellcheck > /dev/null && echo "  [ok] shellcheck found: $(which shellcheck)" || echo "  [info] shellcheck not installed (install via brew/apt for script linting)"
    @which shfmt > /dev/null && echo "  [ok] shfmt found: $(which shfmt)" || echo "  [info] shfmt not installed (install via brew/apt for script formatting)"
    @echo "Environment check complete."

# Lint shell scripts and check Terraform formatting
lint:
    #!/usr/bin/env sh
    set -eu
    echo "=== Running Homelab Linters ==="
    if which shellcheck > /dev/null 2>&1; then
        sh_files="$(find . -type f -name "*.sh" -not -path "*/.agents/*" -not -path "*/.git/*" 2>/dev/null || true)"
        if [ -n "$sh_files" ]; then
            echo "Running shellcheck on shell scripts..."
            shellcheck $sh_files
        else
            echo "No shell scripts found to lint."
        fi
    else
        echo "shellcheck not found. Skipping shell linting."
    fi

    if which terraform > /dev/null 2>&1 && [ -d "gateway/terraform" ]; then
        tf_count="$(find gateway/terraform -name '*.tf' 2>/dev/null | wc -l | tr -d ' ')"
        if [ "$tf_count" -gt 0 ]; then
            echo "Checking Terraform formatting..."
            terraform fmt -check -recursive gateway/terraform/
        fi
    fi
    echo "Lint checks complete."

# Auto-format shell scripts and Terraform code
format:
    #!/usr/bin/env sh
    set -eu
    echo "=== Formatting Homelab Files ==="
    if which shfmt > /dev/null 2>&1; then
        sh_files="$(find . -type f -name "*.sh" -not -path "*/.agents/*" -not -path "*/.git/*" 2>/dev/null || true)"
        if [ -n "$sh_files" ]; then
            echo "Formatting shell scripts with shfmt..."
            shfmt -w -i 4 $sh_files
        fi
    fi

    if which terraform > /dev/null 2>&1 && [ -d "gateway/terraform" ]; then
        tf_count="$(find gateway/terraform -name '*.tf' 2>/dev/null | wc -l | tr -d ' ')"
        if [ "$tf_count" -gt 0 ]; then
            echo "Formatting Terraform code..."
            terraform fmt -recursive gateway/terraform/
        fi
    fi
    echo "Formatting complete."

# Validate Docker Compose configurations
validate:
    #!/usr/bin/env sh
    set -eu
    echo "=== Validating Configurations ==="
    compose_count=0
    for f in services/*/docker-compose.yml gateway/vm/*/docker-compose.yml; do
        if [ -f "$f" ]; then
            compose_count=$((compose_count + 1))
            echo "Validating $f..."
            docker compose -f "$f" config -q
        fi
    done
    if [ "$compose_count" -eq 0 ]; then
        echo "No compose stacks staged for validation yet."
    else
        echo "Validated $compose_count compose files successfully."
    fi

# Format Gateway Terraform files
gateway-fmt:
    @terraform fmt -recursive gateway/terraform/

# Lint Gateway Terraform files
gateway-lint:
    @terraform fmt -check -recursive gateway/terraform/

# Validate Gateway Compose stack
gateway-validate:
    @docker compose -f gateway/vm/platform/docker-compose.yml config -q
    @echo "Gateway platform compose configuration is valid."

# Deploy configuration to remote Aperio Gateway VM via SSH/rsync
gateway-deploy user="ubuntu" host="" key="":
    #!/usr/bin/env sh
    set -eu
    echo "Deploying to Aperio Gateway..."
    bash gateway/vm/deploy.sh "{{user}}" "{{host}}" "{{key}}"

# SSH into Aperio Gateway (Oracle Cloud VPS)
ssh-aperio:
    #!/usr/bin/env sh
    set -eu
    if [ -f .env ]; then set -a; . ./.env; set +a; fi
    if [ -z "${APERIO_PUBLIC_IP:-}" ]; then
        echo "Error: APERIO_PUBLIC_IP is not defined in .env"
        exit 1
    fi
    KEY="${GATEWAY_SSH_KEY:-$HOME/.ssh/id_rsa}"
    echo "Connecting to Aperio (${APERIO_PUBLIC_IP})..."
    ssh -o StrictHostKeyChecking=no -i "$KEY" "ubuntu@${APERIO_PUBLIC_IP}"

# SSH into Macerator Powerhouse (Dell Inspiron)
ssh-macerator target_host="":
    #!/usr/bin/env sh
    set -eu
    if [ -f .env ]; then set -a; . ./.env; set +a; fi
    KEY="${GATEWAY_SSH_KEY:-$HOME/.ssh/id_rsa}"
    GATEWAY="${APERIO_PUBLIC_IP:-}"
    DEFAULT_MACERATOR_IP="${BACKBONE_MACERATOR_IP:-${BACKBONE_POWERHOUSE_IP:-10.10.0.2}}"
    TARGET="{{target_host}}"
    if [ -z "$TARGET" ]; then
        TARGET="$DEFAULT_MACERATOR_IP"
    fi

    # If connecting to the WireGuard backbone IP and gateway is known, ProxyJump through Aperio
    if [ "$TARGET" = "$DEFAULT_MACERATOR_IP" ] || [ "$TARGET" = "10.10.0.2" ]; then
        if [ -z "$GATEWAY" ]; then
            echo "Error: APERIO_PUBLIC_IP required for ProxyJump to $TARGET is not set in .env"
            exit 1
        fi
        echo "Connecting to Macerator ($TARGET) via Aperio bastion ($GATEWAY)..."
        ssh -o StrictHostKeyChecking=no -i "$KEY" -J "ubuntu@$GATEWAY" "vlad@$TARGET"
    else
        echo "Connecting to Macerator ($TARGET)..."
        ssh -o StrictHostKeyChecking=no -i "$KEY" "vlad@$TARGET"
    fi

# Unified SSH shortcut: just ssh-into [aperio|macerator]
ssh-into node="aperio" target_host="":
    #!/usr/bin/env sh
    set -eu
    case "{{node}}" in
        aperio|gateway)
            just ssh-aperio
            ;;
        macerator|powerhouse)
            just ssh-macerator "{{target_host}}"
            ;;
        *)
            echo "Unknown node: {{node}}. Usage: just ssh-into [aperio|macerator]"
            exit 1
            ;;
    esac

# Standard pre-commit hook aggregator (consumed by root monorepo pre-commit)
pre-commit: lint validate
