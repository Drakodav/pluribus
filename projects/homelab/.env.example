# ==============================================================================
# Homelab Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local runtime configuration.
# NOTE: .env is strictly gitignored and must never be committed.
# Future architectural evolution: variables will be injected via GitHub Secrets
# or centralized secret managers for automated CI/CD deployments.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Public Gateway ("aperio" - Oracle Cloud Always-Free VPS)
# ------------------------------------------------------------------------------
# Public IPv4 address assigned to the OCI compute instance
APERIO_PUBLIC_IP=123.45.67.89

# Apex/Root domain used for public routing and Traefik routers (e.g. example.com)
ROOT_DOMAIN=homelab.example.com

# Email address for Let's Encrypt automated ACME certificate registration
ACME_EMAIL=admin@example.com

# Oracle Cloud Infrastructure (OCI) Credentials & Identifiers (Terraform IaC)
OCI_TENANCY_OCID=ocid1.tenancy.oc1..example
OCI_USER_OCID=ocid1.user.oc1..example
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_PRIVATE_KEY_PATH=~/.oci/oci_api_key.pem
OCI_REGION=us-ashburn-1
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..example

# ------------------------------------------------------------------------------
# 2. Encrypted Backbone (WireGuard Private Overlay Network - 10.10.0.0/24)
# ------------------------------------------------------------------------------
# WireGuard Subnet CIDR
BACKBONE_SUBNET=10.10.0.0/24

# Gateway (aperio) WireGuard IP and Listen Port
BACKBONE_APERIO_IP=10.10.0.1
BACKBONE_APERIO_PORT=51820
BACKBONE_APERIO_PUBLIC_KEY=

# Primary Powerhouse (macerator) WireGuard IP
BACKBONE_MACERATOR_IP=10.10.0.10
BACKBONE_MACERATOR_PUBLIC_KEY=

# Backward compatibility alias for legacy scripts
BACKBONE_GATEWAY_IP=10.10.0.1
BACKBONE_POWERHOUSE_IP=10.10.0.10

# ------------------------------------------------------------------------------
# 3. Core Data Services ("macerator" - PostgreSQL & Redis)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_a_secure_password
POSTGRES_DB=homelab

# ------------------------------------------------------------------------------
# 4. Identity & Access Management ("macerator" - Authentik SSO)
# ------------------------------------------------------------------------------
# Secret key used for cookie signing and session encryption (generate with: openssl rand -base64 36)
AUTHENTIK_SECRET_KEY=change_me_authentik_secret_key_32_chars_min

# Initial administrative bootstrap credentials
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
AUTHENTIK_BOOTSTRAP_PASSWORD=change_me_to_a_secure_admin_password

# pgAdmin OAuth2 Integration Credentials
PGADMIN_OAUTH2_CLIENT_ID=
PGADMIN_OAUTH2_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 5. Media & Application Services ("macerator" - Immich Photos & ML)
# ------------------------------------------------------------------------------
IMMICH_VERSION=release
# Storage path on macerator node (standardized under /opt/homelab/)
IMMICH_UPLOAD_LOCATION=/opt/homelab/immich/library
IMMICH_API_KEY=
IMMICH_OAUTH2_CLIENT_ID=
IMMICH_OAUTH2_CLIENT_SECRET=

# Home Assistant OAuth2 Integration Credentials
HOME_ASSISTANT_CLIENT_ID=
HOME_ASSISTANT_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 6. Operator Access & Deployment
# ------------------------------------------------------------------------------
# Path to SSH private key used by deploy.sh (defaults to ~/.ssh/id_rsa)
GATEWAY_SSH_KEY=~/.ssh/id_rsa
