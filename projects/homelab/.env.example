# ==============================================================================
# Homelab Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local runtime configuration.
# NOTE: .env is strictly gitignored and must never be committed.
# All variables adhere to strict domain namespaces: GLOBAL_, NODE_<NAME>_, SERVICE_<NAME>_
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global Cluster & Ingress Domain
# ------------------------------------------------------------------------------
# Apex/Root domain used for public routing and Traefik routers (e.g. example.com)
GLOBAL_ROOT_DOMAIN=homelab.example.com

# Email address for Let's Encrypt automated ACME certificate registration
GLOBAL_ACME_EMAIL=admin@example.com

# Cloudflare API Token for DNS-01 challenge (Permissions: Zone:DNS:Edit for root domain)
GLOBAL_CLOUDFLARE_API_TOKEN=change_me_cloudflare_api_token

# WireGuard overlay network subnet and gateway port
GLOBAL_MESH_SUBNET=10.10.0.0/24
GLOBAL_MESH_PORT=51820

# ------------------------------------------------------------------------------
# 2. Node: aperio (Public Gateway & VPN Bastion)
# ------------------------------------------------------------------------------
# Public IPv4 address assigned to the OCI compute instance
NODE_APERIO_PUBLIC_IP=123.45.67.89

# WireGuard backbone IP and public key
NODE_APERIO_BACKBONE_IP=10.10.0.1
NODE_APERIO_PUBLIC_KEY=

# SSH connection parameters
NODE_APERIO_SSH_USER=ubuntu
NODE_APERIO_SSH_PORT=22
NODE_APERIO_SSH_KEY=~/.ssh/id_rsa

# Oracle Cloud Infrastructure (OCI) Compute Instance ID
NODE_APERIO_INSTANCE_ID=ocid1.instance.oc1..example

# Oracle Cloud Infrastructure (OCI) Terraform Credentials (Optional)
NODE_APERIO_OCI_TENANCY_OCID=ocid1.tenancy.oc1..example
NODE_APERIO_OCI_USER_OCID=ocid1.user.oc1..example
NODE_APERIO_OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
NODE_APERIO_OCI_PRIVATE_KEY_PATH=~/.oci/oci_api_key.pem
NODE_APERIO_OCI_REGION=us-ashburn-1
NODE_APERIO_OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..example

# ------------------------------------------------------------------------------
# 3. Node: macerator (Primary Powerhouse)
# ------------------------------------------------------------------------------
# WireGuard backbone IP and public key
NODE_MACERATOR_BACKBONE_IP=10.10.0.2
NODE_MACERATOR_PUBLIC_KEY=

# SSH connection parameters
NODE_MACERATOR_SSH_USER=admin
NODE_MACERATOR_SSH_PORT=22
NODE_MACERATOR_SSH_BASTION=aperio

# ------------------------------------------------------------------------------
# 4. Service: postgres (Database Engine)
# ------------------------------------------------------------------------------
SERVICE_POSTGRES_USER=postgres
SERVICE_POSTGRES_PASSWORD=change_me_to_a_secure_password
SERVICE_POSTGRES_DB=homelab

# ------------------------------------------------------------------------------
# 5. Service: authentik (Identity & SSO Provider)
# ------------------------------------------------------------------------------
# Secret key used for cookie signing and session encryption (generate with: openssl rand -base64 36)
SERVICE_AUTHENTIK_SECRET_KEY=change_me_authentik_secret_key_32_chars_min

# Initial administrative bootstrap credentials
SERVICE_AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
SERVICE_AUTHENTIK_BOOTSTRAP_PASSWORD=change_me_to_a_secure_admin_password

# ------------------------------------------------------------------------------
# 6. Service: pgadmin (Database Administration Web UI)
# ------------------------------------------------------------------------------
SERVICE_PGADMIN_OAUTH2_CLIENT_ID=
SERVICE_PGADMIN_OAUTH2_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 7. Service: photos (Immich Media Management)
# ------------------------------------------------------------------------------
SERVICE_PHOTOS_VERSION=release
# Storage path on macerator node (standardized under /opt/homelab/)
SERVICE_PHOTOS_UPLOAD_LOCATION=/opt/homelab/immich/library
SERVICE_PHOTOS_API_KEY=
SERVICE_PHOTOS_OAUTH2_CLIENT_ID=
SERVICE_PHOTOS_OAUTH2_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 8. Service: homeassistant (Smart Home Automation)
# ------------------------------------------------------------------------------
SERVICE_HOMEASSISTANT_OAUTH2_CLIENT_ID=
SERVICE_HOMEASSISTANT_OAUTH2_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 9. Service: komodo (Fleet Operations & Cluster Monitoring)
# ------------------------------------------------------------------------------
SERVICE_KOMODO_DB_USER=admin
SERVICE_KOMODO_DB_PASSWORD=change_me_to_a_secure_password
SERVICE_KOMODO_ADMIN_USER=admin
SERVICE_KOMODO_ADMIN_PASSWORD=change_me_to_a_secure_admin_password
SERVICE_KOMODO_JWT_SECRET=change_me_komodo_jwt_secret_32_chars
SERVICE_KOMODO_WEBHOOK_SECRET=change_me_komodo_webhook_secret_32_chars
SERVICE_KOMODO_OIDC_ENABLED=false
SERVICE_KOMODO_OIDC_CLIENT_ID=
SERVICE_KOMODO_OIDC_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 10. Service: coolify (Developer PaaS Engine)
# ------------------------------------------------------------------------------
SERVICE_COOLIFY_APP_ID=coolify-pluribus
SERVICE_COOLIFY_APP_KEY=base64:pluribuscoolifysecretkeyforhomelab1234=
SERVICE_COOLIFY_DB_USER=coolify
SERVICE_COOLIFY_DB_PASSWORD=change_me_to_a_secure_coolify_db_password
SERVICE_COOLIFY_REDIS_PASSWORD=change_me_to_a_secure_coolify_redis_password
SERVICE_COOLIFY_PUSHER_ID=coolify
SERVICE_COOLIFY_PUSHER_KEY=coolify-key
SERVICE_COOLIFY_PUSHER_SECRET=coolify-secret
SERVICE_COOLIFY_OAUTH2_CLIENT_ID=
SERVICE_COOLIFY_OAUTH2_CLIENT_SECRET=

