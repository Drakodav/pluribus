#!/bin/bash
# Pre-commit hook to lint and format Python files in git-history-cv-extractor
set -e

# Find staged Python files in the projects/git-history-cv-extractor/ directory
STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep "^projects/git-history-cv-extractor/.*\.py$" || true)

if [ -n "$STAGED_PY_FILES" ]; then
    echo "Staged python files detected. Running linting and formatting..."
    
    # Store root directory path
    ROOT_DIR=$(pwd)
    
    # Run Ruff check and format inside the project
    cd projects/git-history-cv-extractor
    
    if command -v uv >/dev/null 2>&1; then
        # Run Ruff check with auto-fix
        uv run ruff check --fix .
        # Run Ruff format
        uv run ruff format .
        
        # Stage any modifications made by Ruff to the files that were already staged
        cd "$ROOT_DIR"
        for file in $STAGED_PY_FILES; do
            if git diff --name-only | grep -q "^$file$"; then
                echo "Re-staging formatted/fixed file: $file"
                git add "$file"
            fi
        done
    else
        echo "WARNING: uv not found. Skipping lint/format pre-commit hooks."
    fi
fi
